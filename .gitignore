# Rust
/target/
**/*.rs.bk
*.pdb

# Environment / secrets — never commit real credentials.
.env
.env.local
.env.*.local

# The sqlx offline query cache IS committed on purpose, so a clone builds
# without a database. The build-time database URL is not.
.sqlx/tmp/

# Local-only input material, not application source. `reference/source.html`
# is the ~549 KB Claude Design export the public page was reconstructed from.
# It is needed only when deliberately re-running the design extraction or
# comparing against the original; it has no part in a build. Kept on disk,
# never tracked. Named explicitly rather than ignoring `reference/`, so a file
# that genuinely belongs to the project can be added there later.
reference/source.html

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local runtime data (throwaway Postgres clusters, logs, scratch output).
*.log
pgdata/

# Sijill cell material. The cell lives outside the repository by design
# (docs/sijill-cell-backup.md); this is defence in depth, because cell.key is
# an unprotected signing seed and a single stray commit publishes it forever.
cell.key
log.sijill
log.sijill.horizon
