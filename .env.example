# Copy to .env and adjust. Never commit .env — see .gitignore.

# ---- Server -----------------------------------------------------------------
# Address the web server binds to.
# 127.0.0.1 for local development, 0.0.0.0 in a container.
BIND_ADDR=127.0.0.1

# Port the web server listens on.
PORT=3000

# ---- Database ---------------------------------------------------------------
# Required. Postgres is the source of truth for the studio side; the server
# refuses to start without it, because an order that cannot be stored is lost.
DATABASE_URL=postgres://postgres@localhost:5432/hemsidor24

# ---- Privacy ----------------------------------------------------------------
# Required, at least 16 characters. Mixed into the stored IP hash so the raw
# address is never written down. Generate one with:
#   openssl rand -hex 32
# Changing it makes existing hashes uncomparable, which only affects spam
# forensics.
IP_HASH_SALT=change-me-openssl-rand-hex-32

# ---- Email ------------------------------------------------------------------
# Optional as a group, but all five must be set together. If they are missing
# the site still runs and still stores orders — it just logs loudly that nobody
# is being emailed.
#
# For Gmail: SMTP_USER is the full address and SMTP_PASSWORD is an app
# password, not the account password. Port 587 is STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Where order notifications are sent.
NOTIFY_TO=abdulwahed.sweden@gmail.com

# Envelope sender for both the studio notification and the customer receipt.
NOTIFY_FROM=you@gmail.com

# Optional. Defaults to 587 (STARTTLS submission).
# SMTP_PORT=587

# ---- Back office (hemsidor24-admin) ------------------------------------------
# A second server, on its own port. Loopback by default: this panel has no
# business being reachable from anywhere but the machine it runs on, or
# whatever sits in front of it.
ADMIN_BIND_ADDR=127.0.0.1
ADMIN_PORT=3001

# error | warn | info | debug | trace. Defaults to info.
# ADMIN_LOG=info

# Set both to create the first administrator on next start. The account is
# created once; after that these are ignored and can be removed. rustio-admin
# hashes the password with Argon2id and manages every account from there on.
ADMIN_EMAIL=abdulwahed.sweden@gmail.com
ADMIN_PASSWORD=at-least-12-characters

# Where the studio's Sijill cell lives, for signing handover claims.
#
# Only read when the admin is built with `--features handover` — and then it is
# MANDATORY. That build refuses to start unless this is set, holds a cell that
# opens, and is writable, because starting without it would mean publishing
# successfully while signing nothing.
#
# This directory is durability-critical and is NOT covered by a Postgres backup.
# It holds the studio's signing identity; losing it cannot be undone.
HANDOVER_CELL_DIR=

# Set to 1 exactly once, deliberately, to bring a brand-new cell into being.
# Leave it unset in normal operation and in every deployment: an empty directory
# is what a fresh volume looks like, and creating a cell there would mint a new
# signing identity with an empty log rather than surface the missing one.
# HANDOVER_CELL_INIT=1
